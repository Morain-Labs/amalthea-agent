# Copy to .env.local at the repo root and fill in. .env.local is gitignored.

# Local development: Gemini API key (an AI Studio key works).
GEMINI_API_KEY=

# Optional model override. Defaults to gemini-3.7-flash; documented fallback is
# gemini-3.6-flash if 3.7 misbehaves.
# GEMINI_MODEL=gemini-3.7-flash

# Live API model for the voice spike (optional override).
# GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Deployed service (Cloud Run): route Gemini through Vertex AI with
# Application Default Credentials instead of an API key.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-east1

# Local Firestore emulator (used by the demo app in development).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
