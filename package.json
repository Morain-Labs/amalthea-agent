{
  "name": "amalthea-agent",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.13.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint packages apps",
    "test": "npm run test --workspaces --if-present",
    "dev": "npm run dev --workspace @amalthea/demo"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "eslint": "^9.34.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^4.1.0"
  }
}
